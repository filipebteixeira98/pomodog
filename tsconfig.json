{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["react", "node"],
    "paths": {
      "#assets/*": ["./assets/*"],
      "#src/*": ["./src/*"],
      "#tests/*": ["./tests/*"],
      "#app": ["./App.tsx"],
      "#styles": ["./global.css"]
    }
  }
}
