{
  "expo": {
    "name": "Pomodog",
    "slug": "pomodog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7F2",
    "web": {
      "bundler": "metro",
      "name": "Pomodog",
      "description": "Um pequeno companheiro para o seu tempo de foco.",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF0E6"
        }
      ],
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      [
        "@sentry/react-native/expo",
        {
          "organization": "personal-dashboard",
          "project": "pomodog",
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/withNativeReporting",
      "@react-native-firebase/app"
    ],
    "icon": "./assets/brand/icon.png",
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#4E6B55"
      },
      "package": "com.filipebteixeira98.pomodog",
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"]
    },
    "scheme": "pomodog"
  }
}
