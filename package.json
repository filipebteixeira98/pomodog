{
  "name": "pomodog",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.25",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-notifications": "57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.48.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run.mts",
    "export:web": "expo export --platform web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export:android": "expo export --platform android --output-dir dist-android",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-pomodog --only firestore \"node --experimental-strip-types tests/firestoreRules.mts\"",
    "sentry:export:web": "expo export --platform web --source-maps --output-dir dist-sentry/web",
    "sentry:export:android": "expo export --platform android --source-maps --output-dir dist-sentry/android",
    "sentry:check": "node scripts/sentry-sourcemaps.mjs check",
    "sentry:upload": "node scripts/sentry-sourcemaps.mjs upload"
  },
  "private": true,
  "imports": {
    "#assets/*": "./assets/*",
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#app": "./App.tsx",
    "#styles": "./global.css"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
