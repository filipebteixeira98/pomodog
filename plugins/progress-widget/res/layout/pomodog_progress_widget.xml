<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pomodog_widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="@string/widget_brand" android:textColor="#394D40" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/pomodog_widget_flame" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
            android:text="0" android:textColor="#8B461F" android:textSize="38sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_streak_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/widget_streak_days" android:textColor="#8B461F" android:textSize="14sp" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pomodog_widget_today"
        android:padding="8dp" android:text="@string/widget_today_empty" android:textColor="#394D40" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:text="@string/widget_open" android:textColor="#735A45" android:textSize="11sp" />
</LinearLayout>
