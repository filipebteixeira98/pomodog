<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pomodog_widget_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="@string/widget_brand" android:textColor="#394D40" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/pomodog_widget_flame" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
            android:text="0" android:textColor="#8B461F" android:textSize="32sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_streak_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/widget_streak_days" android:textColor="#8B461F" android:textSize="14sp" android:maxLines="2" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="3dp"
            android:background="@drawable/pomodog_widget_today" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="5dp"
                    android:src="@drawable/pomodog_widget_session" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_today_count" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:includeFontPadding="false" android:gravity="center" android:text="0" android:textColor="#394D40" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
            <TextView android:id="@+id/widget_today_count_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:includeFontPadding="false" android:gravity="center" android:text="@string/widget_sessions_today" android:textColor="#526858"
                android:textSize="10sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp"
            android:background="@drawable/pomodog_widget_today" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="5dp"
                    android:src="@drawable/pomodog_widget_clock" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_today_minutes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:includeFontPadding="false" android:gravity="center" android:text="0" android:textColor="#394D40" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:includeFontPadding="false" android:gravity="center" android:text="@string/widget_minutes_today" android:textColor="#526858"
                android:textSize="10sp" android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="6dp"
        android:background="@drawable/pomodog_widget_week" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_week" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:includeFontPadding="false" android:text="@string/widget_open" android:textColor="#526858" android:textSize="11sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_week_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:includeFontPadding="false" android:text="@string/widget_minutes_empty" android:textColor="#394D40" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" android:visibility="gone" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
